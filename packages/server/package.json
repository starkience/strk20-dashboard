{
  "name": "@strk20/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./handlers": "./src/handlers.ts",
    "./cache": "./src/cache/index.ts",
    "./aggregations": "./src/aggregations/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "start:prod": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@strk20/core": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "^5.6.0"
  }
}
