# Starkscan API
STARKSCAN_BASE_URL=https://api.starkscan.co
STARKSCAN_API_KEY=mzk_live_key_REPLACE_ME
STARKSCAN_CHAIN=SN_MAIN
# Same address-keyed market quotes used by starkscan.co/privacy-pool.
STARKSCAN_MARKET_BASE_URL=https://starkscan.co/api/market

# STRK20 privacy pool contract
STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# API server
API_PORT=8787
API_CORS_ORIGIN=*

# SQLite cache (uses Node's built-in node:sqlite — no native build needed)
CACHE_DB_PATH=./data/cache.db

# Auto-sync: backfill full history on boot, then poll the head on an interval.
# Set BACKFILL_ON_START=false to skip the initial walk. Interval in ms.
BACKFILL_ON_START=true
SYNC_INTERVAL_MS=120000
